# ─────────────────────────────────────────────────────────────────────────────
# DisasterMesh — backend environment variables
# Copy to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Leave blank to use local file mode (no Docker needed).
# Set to Qdrant Cloud URL for production: https://xxxx.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_data

# ── Redis / Upstash ───────────────────────────────────────────────────────────
# Upstash free tier: https://console.upstash.com
# Format: rediss://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev, switch to postgres:// for production
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Mapbox (used by Next.js frontend) ────────────────────────────────────────
MAPBOX_TOKEN=

# ── Twilio (optional, for SMS notifications) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Data paths ────────────────────────────────────────────────────────────────
SENTINEL_DATA_DIR=./demo_data/satellite

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
